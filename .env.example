# Copy this file to .env and fill in your values.
#   cp .env.example .env
# Never commit .env — it is gitignored.

# RPC endpoints (Alchemy, Infura, or a public Sepolia URL)
RPC_URL=
SEPOLIA_RPC_URL=

# Deployer wallet (testnet only — never a mainnet key)
PRIVATE_KEY=

# Optional: contract verification on Etherscan
ETHERSCAN_API_KEY=
